# Existing Google integration settings can remain in your local server/.env.
# Do not commit the real values for any of these variables.
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/google/callback
GEMINI_API_KEY=

# Supabase Step 2: use the project URL and browser-safe Publishable/anon key.
# Never put your Supabase Secret key or service_role key in this file or in client code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
